# Copy this file to `.env` to customise the Docker setup.
# Every value below is optional - defaults shown.

# Host port the app is published on
#APP_PORT=8085

# Frontend -> API base URL baked into the JS bundle.
# Leave empty (recommended): the UI is served by the backend itself,
# so requests stay same-origin and work from any host.
#VITE_API_URL=

# Local PostgreSQL container
#POSTGRES_DB=civic_sense
#POSTGRES_USER=civic
#POSTGRES_PASSWORD=civic_sense

# ...or point the backend at an external database instead
#(these override the local `db` container's connection):
#SPRING_DATASOURCE_URL=jdbc:postgresql://your-host:5432/your-db
#SPRING_DATASOURCE_USERNAME=your-user
#SPRING_DATASOURCE_PASSWORD=your-password
